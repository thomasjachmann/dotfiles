#!/bin/bash

brew bundle --file=/dev/stdin <<EOB
brew "pirj/noclamshell/noclamshell"
brew "jq" # for noclamshell installation in ./install
EOB

function set-defaults() {
  message=$1
  domain=$2
  key=$3
  shift; shift; shift

  previous=$(defaults read $domain "$key")
  oneline_previous=${previous//[[:space:]]/}
  yellow "$message: from ${oneline_previous:0:32} to $*" # limit previous length and store it somewhere?
  defaults write $domain "$key" "$*"
}

function add-to-dock() {
  if [ -d $1 ]; then
    yellow "adding $1 to the dock"
    defaults write com.apple.dock \
      persistent-apps \
      -array-add \
      "<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>$1</string><key>_CFURLStringType</key><integer>0</integer></dict></dict></dict>"
  else
    red "$1 couldn't be added to the dock since it's not there"
  fi
}

source {{ .chezmoi.sourceDir }}/../_helpers.zsh


##################################################
# Dock ###########################################
##################################################
# TODO: it's not bool anymore but number
# but still, this doesn't work although it doesn't change anything in the plist...
set-defaults "setting the dock to auto hide" com.apple.dock autohide 1

set-defaults "removing everything from the dock" com.apple.dock persistent-apps -array
add-to-dock /Applications/OpenInNvim.app

killall Dock


